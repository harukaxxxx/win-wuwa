{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "win-wuwa-local-prototype",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/auth/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "win-wuwa-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }]
}
